---
import { site } from '../data/site';
import { routes, langFromUrl, useT } from '../i18n/ui';
const lang = langFromUrl(Astro.url);
const t = useT(lang);
interface Props { title?: string; button?: string }
const { title = t('cta.title'), button = t('cta.button') } = Astro.props;
---
<section class="section section--accent">
  <div class="wrap cta">
    <h2 class="display display--l" set:html={title} />
    <div class="cta__side" data-reveal>
      <a class="btn btn--dark" href={routes.contact[lang]}>{button}</a>
      <a href={`mailto:${site.email}`} style="font-weight:600">{site.email}</a>
    </div>
  </div>
</section>
