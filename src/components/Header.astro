---
import { nav } from '../data/site';
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
---
<header class="site-header" data-open="false">
  <div class="wrap site-header__inner">
    <a class="logo" href="/" aria-label="simkovabarb – domov">simkovabarb<span class="dot">.</span></a>
    <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="hlavne-menu">Menu</button>
    <nav class="nav" id="hlavne-menu" aria-label="Hlavné menu">
      {nav.map((item) => (
        <a href={item.href} aria-current={path.startsWith(item.href) ? 'page' : undefined}>{item.label}</a>
      ))}
      <a class="btn btn--accent" href="/kontakt">Napíšte mi</a>
    </nav>
  </div>
</header>
<script>
  const header = document.querySelector<HTMLElement>('.site-header');
  const toggle = header?.querySelector<HTMLButtonElement>('.nav-toggle');
  toggle?.addEventListener('click', () => {
    const open = header!.dataset.open !== 'true';
    header!.dataset.open = String(open);
    toggle.setAttribute('aria-expanded', String(open));
    toggle.textContent = open ? 'Zavrieť' : 'Menu';
  });
</script>
