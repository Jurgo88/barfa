---
import { reels } from '../data/site';
interface Props { limit?: number }
const { limit = 4 } = Astro.props;
const list = reels.slice(0, limit);
---
<div class="reels">
  {list.map((id, i) => (
    <div class="reel" data-id={id}>
      <button type="button" aria-label={`Prehrať reel ${i + 1}`}>
        <img src={`https://i.ytimg.com/vi/${id}/hqdefault.jpg`} alt="" loading="lazy" decoding="async" />
        <span class="reel__play" aria-hidden="true">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z" /></svg>
        </span>
      </button>
    </div>
  ))}
</div>
<script>
  document.querySelectorAll<HTMLElement>('.reel').forEach((reel) => {
    reel.querySelector('button')?.addEventListener('click', () => {
      const id = reel.dataset.id;
      reel.innerHTML = `<iframe src="https://www.youtube-nocookie.com/embed/${id}?autoplay=1&rel=0" title="Reel" allow="autoplay; encrypted-media; picture-in-picture" allowfullscreen></iframe>`;
    });
  });
</script>
