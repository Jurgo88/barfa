---
import { Image } from 'astro:assets';
import type { Project } from '../data/projects';
interface Props { project: Project; ratio?: string; more?: boolean; headingLevel?: 'h2' | 'h3' }
const { project, ratio = '3 / 2', more = true, headingLevel = 'h3' } = Astro.props;
const H = headingLevel;
---
<a class="card" href={`/praca/${project.slug}`} data-categories={project.categories.join(' ')}>
  <div class="card__img">
    <Image src={project.cover} alt={`${project.alt} – ${project.short}`} widths={[480, 800, 1200]} sizes="(max-width: 760px) 100vw, 50vw" style={`aspect-ratio:${ratio}`} />
  </div>
  <div class="tags">{project.tags.map((t) => <span class="tag">{t}</span>)}</div>
  <H class="card__title">{project.short}</H>
  {more && <span class="card__more">Pozrieť projekt →</span>}
</a>
