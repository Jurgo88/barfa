---
import Base from '../../layouts/Base.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import CtaBand from '../../components/CtaBand.astro';
import { projects, categories } from '../../data/projects';
---
<Base title="Práca" description="Vybrané projekty Barbary Šimkovej: produktová fotografia, koncerty, zákulisie reklám, eventy, portréty a grafický dizajn.">
  <section class="wrap section" style="padding-bottom:40px;display:flex;flex-direction:column;gap:24px">
    <h1 class="display display--l">Práca</h1>
    <p class="lead">Výber projektov pre značky, kapely a agentúry. Každý projekt má svoj príbeh: čo klient potreboval a čo z toho vzniklo.</p>
    <div class="filters" role="group" aria-label="Filter projektov">
      {categories.map((c, i) => (
        <button class="filter" type="button" data-filter={c.id} aria-pressed={i === 0 ? 'true' : 'false'}>{c.label}</button>
      ))}
    </div>
  </section>
  <section class="wrap section section--tight-top">
    <div class="grid grid--3" id="projekty" style="row-gap:48px">
      {projects.map((p) => <ProjectCard project={p} ratio="4 / 5" more={false} headingLevel="h2" />)}
    </div>
    <p id="ziadne" class="muted" hidden>V tejto kategórii zatiaľ nie sú projekty.</p>
  </section>
  <CtaBand title="Chcete niečo<br>podobné?" />
</Base>
<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('.filter');
  const cards = document.querySelectorAll<HTMLElement>('#projekty .card');
  const empty = document.getElementById('ziadne');
  buttons.forEach((btn) =>
    btn.addEventListener('click', () => {
      const f = btn.dataset.filter!;
      buttons.forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
      let shown = 0;
      cards.forEach((card) => {
        const show = f === 'all' || card.dataset.categories!.split(' ').includes(f);
        card.hidden = !show;
        if (show) shown++;
      });
      if (empty) empty.hidden = shown > 0;
    }),
  );
</script>
