---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import { projects } from '../../data/projects';

export function getStaticPaths() {
  return projects.map((project, i) => ({
    params: { slug: project.slug },
    props: { project, next: projects[(i + 1) % projects.length] },
  }));
}
const { project, next } = Astro.props;
const cover = project.cover;
const rest = project.gallery.filter((g) => g !== cover);
---
<Base title={project.short} description={`${project.service} pre ${project.client}. ${project.brief.replace(/[\[\]]/g, '')}`.slice(0, 158)} image={project.cover}>
  <section class="wrap" style="padding-top:56px;padding-bottom:40px;display:flex;flex-direction:column;gap:20px">
    <a class="muted" href="/praca">← Späť na prácu</a>
    <p class="eyebrow">{project.service}</p>
    <h1 class="display display--l">{project.title}</h1>
  </section>

  <div class="wrap">
    <Image src={cover} alt={`${project.alt} – hlavná fotka projektu`} widths={[800, 1400, 2000]} sizes="(max-width: 1320px) 100vw, 1272px" loading="eager" style="width:100%;max-height:85vh;object-fit:cover;border-radius:4px" />
  </div>

  <dl class="wrap meta">
    <div><dt>Klient</dt><dd>{project.client}</dd></div>
    <div><dt>Služba</dt><dd>{project.service}</dd></div>
    <div><dt>Moja rola</dt><dd>{project.role}</dd></div>
    <div><dt>Rok</dt><dd>{project.year}</dd></div>
  </dl>

  <section class="wrap section story">
    <div class="story__row"><h2>Zadanie</h2><p>{project.brief}</p></div>
    <div class="story__row"><h2>Riešenie</h2><p>{project.solution}</p></div>
    <div class="story__row"><h2>Výsledok</h2><p>{project.result}</p></div>
  </section>

  <section class="wrap section section--tight-top" aria-label="Galéria">
    <div class="gallery">
      {rest.map((img, i) => (
        <figure><Image src={img} alt={`${project.alt}, fotka ${i + 2}`} widths={[480, 800, 1200]} sizes="(max-width: 760px) 100vw, 33vw" /></figure>
      ))}
    </div>
  </section>

  {project.quote && (
    <section class="wrap section section--tight-top">
      <figure style="background:var(--surface);border-radius:4px;padding:48px;display:flex;flex-direction:column;gap:20px">
        <blockquote style="font-size:26px;line-height:1.4">„{project.quote.text}“</blockquote>
        <figcaption class="muted">{project.quote.author}</figcaption>
      </figure>
    </section>
  )}

  <section class="border-top">
    <div class="wrap next section" style="padding-top:56px;padding-bottom:56px">
      <a href={`/praca/${next.slug}`} style="display:flex;flex-direction:column;gap:6px">
        <span class="eyebrow">Ďalší projekt</span>
        <span style="font-size:28px;font-weight:600">{next.short} →</span>
      </a>
      <a class="btn btn--accent" href="/kontakt">Chcem podobný projekt</a>
    </div>
  </section>
</Base>
