---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';
import Reels from '../components/Reels.astro';
import CtaBand from '../components/CtaBand.astro';
import { featured } from '../data/projects';
import { clients, site } from '../data/site';
import hero from '../assets/foto/hero.jpg';
---
<Base>
  <section class="wrap hero">
    <div class="hero__text">
      <p class="eyebrow">Fotografia · Video &amp; Reels · Grafický dizajn</p>
      <h1 class="display display--xl">Visuals<br />with<br />character<span class="dot">.</span></h1>
      <p class="lead">Fotografia, dizajn a obsah na sociálne siete s rockovou energiou. Robím vizuály, ktoré nielen dobre vyzerajú, ale aj zaujmú, fungujú a zanechajú stopu.</p>
      <div class="btn-row">
        <a class="btn btn--light" href="/praca">Pozrieť práce</a>
        <a class="btn btn--ghost" href="/kontakt">Poslať dopyt</a>
      </div>
    </div>
    <div class="hero__media">
      <Image src={hero} alt="Spevák na pódiu v dyme so zdvihnutou rukou" widths={[480, 800, 1200]} sizes="(max-width: 760px) 100vw, 40vw" loading="eager" fetchpriority="high" />
    </div>
  </section>

  <section class="clients" aria-label="Klienti">
    <div class="wrap clients__inner">
      <span class="eyebrow">Pracovala som pre</span>
      {clients.map((c) => <span class="clients__name">{c}</span>)}
    </div>
  </section>

  <section class="section wrap">
    <div class="section-head">
      <h2 class="display display--m">Vybrané projekty</h2>
      <a class="link-underline" href="/praca">Všetky projekty →</a>
    </div>
    <div class="grid grid--2">
      {featured.map((p) => <ProjectCard project={p} />)}
    </div>
  </section>

  <section class="section section--light">
    <div class="wrap">
      <div class="section-head">
        <h2 class="display display--m">Čo pre vás urobím</h2>
        <a class="link-underline" href="/sluzby">Služby a spolupráca →</a>
      </div>
      <div class="grid grid--3">
        <div class="service-col"><span class="service-col__num">01</span><h3>Fotografia</h3><p>Produktové a kampaňové fotky, eventy, koncerty, portréty tímu.</p></div>
        <div class="service-col"><span class="service-col__num">02</span><h3>Video &amp; Reels</h3><p>Krátke videá pre Instagram a TikTok, zákulisie natáčaní, obsah z eventov.</p></div>
        <div class="service-col"><span class="service-col__num">03</span><h3>Grafický dizajn</h3><p>Vizuály kampaní, grafika na sociálne siete, plagáty a merch.</p></div>
      </div>
    </div>
  </section>

  <section class="section wrap">
    <h2 class="display display--m" style="margin-bottom:48px">Ako spolupráca prebieha</h2>
    <ol class="steps grid grid--4">
      <li><strong>1 · Brief</strong><span>Krátky hovor: čo potrebujete, pre koho a dokedy.</span></li>
      <li><strong>2 · Koncept</strong><span>Návrh nápadu, štýlu a ponuka s cenou.</span></li>
      <li><strong>3 · Produkcia</strong><span>Focenie, natáčanie alebo dizajn.</span></li>
      <li><strong>4 · Odovzdanie</strong><span>Hotové súbory vo formátoch pre web aj siete.</span></li>
    </ol>
  </section>

  {/* TODO: referencie – doplniť citáty klientov a odkomentovať
  <section class="section section--tight-top wrap">…</section>
  */}

  <section class="section border-top wrap" id="reels">
    <div class="section-head">
      <h2 style="font-size:28px;font-weight:600">Najnovšie reels</h2>
      {site.socials.instagram && <a class="link-underline" href={site.socials.instagram} target="_blank" rel="noopener">Instagram →</a>}
    </div>
    <Reels limit={4} />
  </section>

  <CtaBand />
</Base>
