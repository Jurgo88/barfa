---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import { projects } from '../data/projects';

const by = (slug: string) => projects.find((p) => p.slug === slug)!;
const services = [
  { num: '01', name: 'Fotografia', img: by('popradska-produktove-foto').gallery[1], alt: 'Produktová fotka Popradská Ginko', text: 'Fotky, ktoré majú náladu a dajú sa hneď použiť na web, e-shop aj sociálne siete.', items: ['Produktové fotky', 'Kampane a lookbooky', 'Eventy a koncerty', 'Portréty tímu'], link: '/praca' },
  { num: '02', name: 'Video & Reels', img: by('zakulisie-natacania-reklamy').gallery[7], alt: 'Kamera na natáčaní reklamy', text: 'Krátke vertikálne videá, ktoré zastavia scrollovanie. Natočené a zostrihané pre Instagram a TikTok.', items: ['Reels a TikToky', 'Zákulisie natáčaní (BTS)', 'Videá z eventov', 'Krátke produktové videá'], link: '/#reels' },
  { num: '03', name: 'Grafický dizajn', img: by('popradska-grafika').gallery[1], alt: 'Grafika Explózia chuti pre Popradskú', text: 'Vizuály, ktoré k fotkám ladia. Od jedného príspevku po celú kampaň.', items: ['Grafika na sociálne siete', 'Vizuály kampaní', 'Plagáty a pozvánky', 'Merch a obaly'], link: '/praca/popradska-grafika' },
];
const faq = [
  { q: 'Ako rýchlo dodáte hotové fotky?', a: '[Napr. do 7 pracovných dní od focenia.]' },
  { q: 'Cestujete aj mimo svojho mesta?', a: '[Odpoveď]' },
  { q: 'Kto vlastní práva k fotkám?', a: '[Odpoveď k licencii]' },
  { q: 'Fakturujete na firmu?', a: '[Odpoveď]' },
];
---
<Base title="Služby" description="Fotografia, video a reels a grafický dizajn pre značky. Produktové fotky, obsah na sociálne siete, kampane a balíčky na mieru.">
  <section class="wrap section" style="padding-bottom:56px;display:flex;flex-direction:column;gap:24px">
    <h1 class="display display--l">Služby</h1>
    <p class="lead">Foto, video aj grafika od jedného človeka. Značka tak dostane jednotný vizuál bez toho, aby ste koordinovali troch dodávateľov.</p>
  </section>

  <section class="wrap">
    {services.map((s) => (
      <article class="service">
        <div class="service__img"><Image src={s.img} alt={s.alt} widths={[480, 800, 1200]} sizes="(max-width: 760px) 100vw, 40vw" /></div>
        <div class="service__body">
          <span class="service-col__num" style="color:var(--accent);font-size:22px">{s.num}</span>
          <h2 class="display display--m">{s.name}</h2>
          <p class="lead">{s.text}</p>
          <ul class="service__list">{s.items.map((it) => <li>{it}</li>)}</ul>
          <div style="display:flex;flex-wrap:wrap;gap:20px;align-items:center">
            <span class="muted">Cena od <strong style="color:var(--text)">[CENA] €</strong></span>
            <a class="link-underline" href={s.link}>Ukážky →</a>
          </div>
        </div>
      </article>
    ))}
  </section>

  <section class="section section--light" style="margin-top:40px">
    <div class="wrap">
      <h2 class="display display--m" style="margin-bottom:12px">Balíčky pre sociálne siete</h2>
      <p style="color:var(--light-muted);font-size:19px;max-width:620px;margin-bottom:40px">Pre značky, ktoré potrebujú obsah pravidelne.</p>
      <div class="packages">
        <div class="package"><h3>Štart</h3><span class="package__price">[CENA] €</span><ul><li>[počet] fotiek</li><li>[počet] reels</li><li>1 deň focenia</li></ul></div>
        <div class="package package--dark"><div style="display:flex;justify-content:space-between;align-items:center;gap:12px"><h3>Mesačný obsah</h3><span class="badge">Najčastejšie</span></div><span class="package__price">[CENA] € / mes.</span><ul><li>[počet] fotiek mesačne</li><li>[počet] reels mesačne</li><li>Grafika k príspevkom</li></ul></div>
        <div class="package"><h3>Kampaň na mieru</h3><span class="package__price">Na dopyt</span><ul><li>Koncept a vizuál</li><li>Foto + video + grafika</li><li>Podklady pre web, siete, print</li></ul></div>
      </div>
    </div>
  </section>

  <section class="wrap section split">
    <h2 class="display display--s">Časté otázky</h2>
    <div class="faq">
      {faq.map((f, i) => <details open={i === 0}><summary>{f.q}</summary><p>{f.a}</p></details>)}
    </div>
  </section>

  <section class="section section--accent">
    <div class="wrap cta" style="align-items:center">
      <h2 class="display display--m">Neviete, čo vybrať?</h2>
      <a class="btn btn--dark" href="/kontakt">Napíšte, poradím</a>
    </div>
  </section>
</Base>
